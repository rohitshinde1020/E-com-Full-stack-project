# URL of your deployed backend API (e.g. https://your-backend.vercel.app)
VITE_BACKEND_URL=http://localhost:3000

# Google reCAPTCHA v3 Site Key
# Get this key from: https://www.google.com/recaptcha/admin
# This is the public key used on the frontend
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Razorpay publishable key (used for the Razorpay checkout widget on the frontend)
